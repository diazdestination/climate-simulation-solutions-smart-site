# Names only — never commit values. Set secrets with `wrangler secret put NAME`.
# Plain vars already live in wrangler.jsonc "vars". Local preview reads ONLY the
# process environment (vite.config.mjs never loads .env files).

# GrowthOS (connected by default; delivery fails closed until ID + secret exist)
SMART_SITE_GROWTHOS_ENABLED=true
GROWTHOS_API_ORIGIN=https://app.mogulforge.ai
GROWTHOS_SITE_ID=
GROWTHOS_SITE_SECRET=
# Optional host pin once the production domain is approved
SITE_PUBLIC_ORIGIN=

# Durable lead outbox (D1 binding DB)
SITE_OUTBOX_ENABLED=true
SITE_OUTBOX_ENCRYPTION_KEY=
SITE_OUTBOX_DRAIN_SECRET=

# Website assistant (private preview; public needs config.voice.public too)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_PUBLIC=false

# Email bridge stays OFF while GrowthOS is connected. No SMS variables: SMS is not enabled.

# Local-build-only override for the release gate. Never set in wrangler vars or deploy jobs.
# SITE_ALLOW_UNCONFIRMED_FACTS=true
