{
  "name": "climate-simulation-solutions-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Climate Simulation Solutions HVAC smart site: Vite + React front end on the smart-site-starter core (Cloudflare adapter).",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4391 --strictPort",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4391 --strictPort",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:config": "node scripts/check-config.mjs",
    "check:core": "node C:/Forge/workspace/smart-site-starter/scripts/sync-core.mjs --target . --check",
    "release:check": "node scripts/release-gate.mjs --strict",
    "provision:dry-run": "node core/agent/provision.mjs --config site.config.mjs --templates agent --dry-run",
    "qa:bot-check": "node scripts/qa-bot-check-flow.mjs"
  },
  "dependencies": {
    "@elevenlabs/react": "1.12.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2"
  }
}
