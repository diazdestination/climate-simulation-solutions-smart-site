# Public business phone, including country code, once the office approves it.
NEXT_PUBLIC_BUSINESS_PHONE=

# Private Node >=22.13 runtime with a persistent LOCAL disk is required.
# Serverless/edge/Cloudflare deployments are not supported by this adapter.
# All values below are SERVER ONLY. Never use a NEXT_PUBLIC_ prefix.
# Approved deployed website origin, without a path, e.g. https://approved-domain.
SITE_ORIGIN=
GROWTHOS_API_ORIGIN=
GROWTHOS_SITE_ID=
GROWTHOS_SITE_SECRET=
# Absolute non-web-served path on a persistent volume, outside public/.next/out/dist.
GROWTHOS_JOURNAL_PATH=
# Separate 32-byte random keys encoded as 64 hex characters. Use a secret store.
GROWTHOS_JOURNAL_ENCRYPTION_KEY=
GROWTHOS_OPERATOR_TOKEN=
# Set css-request-contact-v1 only after the office approves the exact contact copy.
GROWTHOS_CONTACT_POLICY_VERSION=
# Only enable once a supervised worker and office delivery review are configured.
GROWTHOS_WORKER_ENABLED=false
# Optional SQLite-consistent backup command requires Node >=22.16 and an existing
# absolute private directory. Recover the encryption key separately in the secret store.
GROWTHOS_BACKUP_DIRECTORY=
# Synthetic loopback tests only; rejected by NODE_ENV=production.
GROWTHOS_ALLOW_LOCAL=false
