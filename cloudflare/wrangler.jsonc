{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "climate-simulation-solutions-site",
  "main": "./worker/capture.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "HVAC_CAPTURE_ENABLED": "false"
  }
}
